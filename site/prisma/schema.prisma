generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Booking {
  id          String   @id @default(cuid())
  serviceSlug String
  date        String   // YYYY-MM-DD
  time        String   // HH:MM
  clientName  String
  clientEmail String?
  clientPhone String?
  clientNotes String?
  status      String   @default("pending") // pending, confirmed, cancelled
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([date, time])
  @@index([status])
}

model WorkingDay {
  id        String   @id @default(cuid())
  dayOfWeek Int      @unique // 0 = Sunday, 1 = Monday, etc.
  isWorking Boolean  @default(true)
  startTime String   @default("10:00")
  endTime   String   @default("17:00")
  updatedAt DateTime @updatedAt
}

// Legacy: superseded by DateException rows with a shared groupId. Kept so old data isn't lost.
model BlockedPeriod {
  id        String   @id @default(cuid())
  startDate String   // YYYY-MM-DD
  endDate   String   // YYYY-MM-DD
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DateException {
  id           String   @id @default(cuid())
  date         String   @unique // YYYY-MM-DD
  isWorking    Boolean  @default(false) // false = day closed. true = open (with optional custom hours / blocked hours)
  startTime    String?  // HH:MM — custom opening for this day; null = use weekly template
  endTime      String?  // HH:MM — custom closing for this day; null = use weekly template
  blockedHours String[] // Array of "HH:MM"
  note         String?  // Reason shown in admin ("Отпуск", "Праздник", ...)
  groupId      String?  // Days created by one "period" action share this id
  updatedAt    DateTime @updatedAt

  @@index([groupId])
}

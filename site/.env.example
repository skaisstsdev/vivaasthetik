# Адрес сайта (с www) — используется для canonical, sitemap и разметки
NEXT_PUBLIC_SITE_URL=https://www.vivaasthetik.de

# Google Analytics 4: ID вида G-XXXXXXXXXX. Пока не задан — аналитика полностью выключена.
# Включается только после того, как посетитель нажал «Принять» в cookie-баннере.
NEXT_PUBLIC_GA_ID=

# Подтверждение сайта в Google Search Console (значение content из мета-тега
# <meta name="google-site-verification" content="...">). Не нужно, если подтверждаете через DNS.
NEXT_PUBLIC_GSC_VERIFICATION=

# Подтверждение в Bing Webmaster Tools (значение msvalidate.01), по желанию
NEXT_PUBLIC_BING_VERIFICATION=

# Чат-ассистент (OpenAI). Ключ только на сервере, без префикса NEXT_PUBLIC.
# Создаётся на platform.openai.com → API keys. Пока не задан — чат отвечает «недоступен».
OPENAI_API_KEY=
# Модель по желанию (по умолчанию gpt-5-mini)
OPENAI_MODEL=
